generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
}

enum PlaceStatus {
  pending
  approved
  rejected
}

model User {
  id Int @id @default(autoincrement())

  email       String?  @unique
  password    String?
  username    String   @unique
  phoneNumber String?  @unique
  role        Role     @default(user)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile          Profile?
  places           Place[]         @relation("PlaceAddedBy")
  scenicPins       ScenicPin[]     @relation("ScenicPinAddedBy")
  events           Event[]         @relation("EventAddedBy")
  suggestCards     SuggestCard[]   @relation("SuggestCardAddedBy")
  ads              Ad[]            @relation("AdAddedBy")
  brands           Brand[]         @relation("BrandAddedBy")
  favorites        Favorite[]
  ratings          Rating[]
  eventAttendances EventAttendee[]

  @@map("users")
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  contact   String
  method    String
  codeHash  String
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([contact])
  @@map("otp_codes")
}

model Profile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  about           String?
  avatarImage     String?
  socialMediaURL  String?
  backgroundImage String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("profiles")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId   String
  createdAt DateTime @default(now())

  @@unique([userId, placeId])
  @@map("favorites")
}

model Rating {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetKey String
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, targetKey])
  @@map("ratings")
}

model Category {
  id     Int     @id @default(autoincrement())
  slug   String  @unique
  name   String
  nameEn String
  image  String?

  videoImage    String?
  subCategories String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  places Place[]

  @@map("categories")
}

model Aimag {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  nameEn          String
  backgroundImage String?
  geoShape        String?
  labelX          Float?
  labelY          Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  places     Place[]
  scenicPins ScenicPin[]
  events     Event[]

  @@map("aimags")
}

model Place {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  images       String[] @default([])
  categoryId   Int
  category     Category @relation(fields: [categoryId], references: [id])
  aimagId      Int
  aimag        Aimag    @relation(fields: [aimagId], references: [id])
  lat          Float?
  lng          Float?
  openTime     String?
  closeTime    String?
  googleMapUrl String?
  subCategory  String?

  phone        String
  instagramUrl String
  facebookUrl  String
  contactEmail String
  accessible   Boolean     @default(false)
  addedBy      Int
  addedByUser  User        @relation("PlaceAddedBy", fields: [addedBy], references: [id])
  status       PlaceStatus @default(pending)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("places")
}

model ScenicPin {
  id           Int      @id @default(autoincrement())
  name         String
  type         String
  description  String?
  images       String[] @default([])
  aimagId      Int
  aimag        Aimag    @relation(fields: [aimagId], references: [id])
  lat          Float?
  lng          Float?
  googleMapUrl String?
  addedBy      Int
  addedByUser  User     @relation("ScenicPinAddedBy", fields: [addedBy], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("scenic_pins")
}

model SiteSettings {
  id                         Int      @id @default(1)
  aboutBackgroundImage       String?
  homeBackgroundImage        String?
  mongoliaFlagImage          String?
  suggestBackgroundImages    Json?
  loaderBackgroundImage      String?
  loginBackgroundImage       String?
  travelAppsBackgroundImages Json?
  teamImages                 Json?
  updatedAt                  DateTime @updatedAt

  @@map("site_settings")
}

model Event {
  id        Int       @id @default(autoincrement())
  name      String
  tag       String?
  meta      String?
  images    String[]  @default([])
  startDate DateTime
  endDate   DateTime?
  aimagId   Int
  aimag     Aimag     @relation(fields: [aimagId], references: [id])
  lat       Float?
  lng       Float?
  featured  Boolean   @default(false)

  instagram   String?
  facebook    String?
  phone       String?
  // Optional second contact number — organizers often list a backup.
  phone2      String?
  addedBy     Int
  addedByUser User            @relation("EventAddedBy", fields: [addedBy], references: [id])
  attendees   EventAttendee[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("events")
}

model EventAttendee {
  id        Int      @id @default(autoincrement())
  eventId   Int
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@map("event_attendees")
}

model SuggestCard {
  id Int @id @default(autoincrement())

  collectionSlug String
  name           String
  description    String?
  image          String?
  link           String?
  featured       Boolean  @default(false)
  group          String?
  addedBy        Int
  addedByUser    User     @relation("SuggestCardAddedBy", fields: [addedBy], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("suggest_cards")
}

model CountrySite {
  id        Int      @id @default(autoincrement())
  country   String
  countryId String
  position  Int
  name      String
  kind      String
  imageUrl  String
  sourceUrl String?
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryId, position])
  @@index([country])
  @@map("country_sites")
}

model Ad {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  image       String?
  startDate   DateTime?
  endDate     DateTime?
  active      Boolean   @default(true)
  views       Int       @default(0)
  addedBy     Int
  addedByUser User      @relation("AdAddedBy", fields: [addedBy], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("ads")
}

model Brand {
  id          Int      @id @default(autoincrement())
  name        String
  category    String
  image       String?
  logo        String?
  link        String?
  active      Boolean  @default(true)
  addedBy     Int
  addedByUser User     @relation("BrandAddedBy", fields: [addedBy], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("brands")
}
